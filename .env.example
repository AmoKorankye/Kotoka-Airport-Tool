# OpenAI API Configuration# Environment variables for Kotoka Airport Chatbot API

OPENAI_API_KEY=your_openai_api_key_here# Copy this file to .env and add your actual API keys



# Google Maps API Configuration# Required: OpenAI API Key (get from https://platform.openai.com/api-keys)

GOOGLE_MAPS_API_KEY=your_google_maps_api_key_hereOPENAI_API_KEY=your-openai-api-key-here



# Chatbots Africa WhatsApp API Configuration# Required: Google Maps API Key (get from https://console.cloud.google.com/)

CHATBOTS_AFRICA_API_KEY=your_chatbots_africa_api_key_here# Make sure to enable Places API and Directions API

GOOGLE_MAPS_API_KEY=your-google-maps-api-key-here

# Flask Environment (optional)

FLASK_ENV=development# Optional: WhatsApp Integration via Chatbots Africa

# Get your API key from Chatbots Africa dashboard
CHATBOTS_AFRICA_API_KEY=your-chatbots-africa-api-key-here
